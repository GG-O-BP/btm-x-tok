# btm-x-tok — ALLOWLIST .gitignore
# Published = spec/docs + the two submodules + each agent's NATIVE config only.
# Ignore everything, then re-include the publishable set. Integration code
# (monitor/, vendor/, scripts/, Cargo.*, MERGE_PLAN.md, .attic/) and any future
# file stays ignored and cannot be accidentally committed.
#
# Pattern rules: "/*" matches only top-level entries ("*" never crosses "/").
# Git won't descend into an ignored dir, so a dir is re-included ("!/.claude/")
# before its contents ("!/.claude/**"). Local-only agent files are re-ignored last.

# default-deny floor (top-level only)
/*

# publishable top-level files
!/.gitignore
!/.gitmodules
!/LICENSE
!/NOTICE
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/.aider.conf.yml

# upstream submodules (gitlinks)
!/bottom
!/tokscale

# each agent's NATIVE config dir (dir first so git descends, then contents)
!/.claude/
!/.claude/**
!/.cursor/
!/.cursor/**
!/.gemini/
!/.gemini/**
!/.github/
!/.github/**

# ...but keep LOCAL-only agent files out (re-ignored within the allowed dirs)
/.claude/settings.local.json
/.claude/**/*.local.json
